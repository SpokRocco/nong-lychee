# ===== Frontend (Vite) - ค่าเหล่านี้ "เปิดเผยต่อเบราว์เซอร์" ใส่ได้เฉพาะ anon key เท่านั้น =====
# ใช้โปรเจกต์ Supabase เดียวกับเว็บไซต์โรงเรียน (ข้อมูลน้องลิ้นจี่อยู่ใน schema "nong_lychee" แยกจากเว็บโรงเรียน)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# (ไม่บังคับ) URL โมเดล 3D .glb / .vrm เช่น /models/nong-lychee.glb (วางไฟล์ไว้ใน public/models)
# ถ้าไม่ตั้งค่า หรือโหลดไม่สำเร็จ ระบบจะใช้โมเดล Procedural น้องลิ้นจี่ในตัวแทน
VITE_MASCOT_MODEL_URL=

# (ไม่บังคับ / เฉพาะทดสอบในเครื่อง) เรียก Gemini ตรงจากเบราว์เซอร์เมื่อยังไม่ได้ตั้ง Supabase
# คำเตือน: คีย์ที่ขึ้นต้น VITE_ จะถูกฝังในไฟล์ JS ห้ามตั้งค่านี้บน Vercel production
VITE_DEV_GEMINI_API_KEY=

# (ไม่บังคับ) เปลี่ยนที่มาของไฟล์ MediaPipe
VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.21/wasm
VITE_MEDIAPIPE_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_detector/blaze_face_short_range/float16/1/blaze_face_short_range.tflite

# ===== Supabase Edge Functions secrets (ตั้งด้วย `supabase secrets set ...` ไม่ใส่ในไฟล์ฝั่งหน้าเว็บ) =====
# secrets ของ Supabase เป็นระดับ "โปรเจกต์" ใช้ร่วมกับเว็บโรงเรียน → ของน้องลิ้นจี่ขึ้นต้นด้วย NONG_LYCHEE_ เสมอ
# NONG_LYCHEE_GEMINI_API_KEY=...
# NONG_LYCHEE_GEMINI_MODEL=gemini-2.5-flash
# NONG_LYCHEE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001   # text-embedding-004 ถูกปิดบริการบน Gemini API แล้ว ดู README
# NONG_LYCHEE_SYNC_SECRET=ตั้งรหัสลับยาว ๆ (ใช้ร่วมกับ Google Apps Script)
# NONG_LYCHEE_LINE_CHANNEL_SECRET=...
# NONG_LYCHEE_LINE_CHANNEL_ACCESS_TOKEN=...
# NONG_LYCHEE_ALLOWED_ORIGIN=https://YOUR-APP.vercel.app
